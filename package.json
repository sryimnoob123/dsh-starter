{
  "name": "dsh-desktop",
  "productName": "deepseek-harness-starter",
  "version": "0.4.8",
  "description": "DeepSeek Harness desktop client (Electron shell). Independent open-source project.",
  "license": "MIT",
  "author": "dsh-desktop contributors",
  "type": "module",
  "main": "dist/main/app.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/postbuild.mjs",
    "prepare:dsh": "node scripts/prepare-dsh.mjs",
    "dist": "pnpm prepare:dsh && pnpm build && node scripts/build-installer.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/ws": "8.18.1",
    "electron": "^43.4.0",
    "electron-builder": "^24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
